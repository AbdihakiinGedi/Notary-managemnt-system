ARG VITE_API_BASE_URL
ARG COOLIFY_FQDN
ARG SERVICE_BASE64_64_JWT_SECRET
ARG SERVICE_BASE64_JWT_SECRET
ARG POSTGRES_DB
ARG POSTGRES_USER
ARG POSTGRES_PASSWORD
ARG DATABASE_URL
ARG PGHOST
ARG PGPORT
ARG JWT_SECRET
ARG JWT_EXPIRES_IN
ARG CORS_ORIGIN
ARG JSON_BODY_LIMIT
ARG UPLOAD_MAX_BYTES
ARG SMTP_HOST
ARG SMTP_PORT
ARG SMTP_USER
ARG SMTP_PASSWORD
ARG SMTP_SECURE
ARG EMAIL_HOST
ARG EMAIL_PORT
ARG EMAIL_USER
ARG EMAIL_PASS
ARG EMAIL_SECURE
ARG EMAIL_FROM
ARG EMAIL_FROM_NAME
ARG SMS_API_USERNAME
ARG SMS_API_PASSWORD
ARG COOLIFY_BUILD_SECRETS_HASH

FROM node:20-alpine AS build

WORKDIR /app

ARG VITE_API_BASE_URL=https://api.digitalmeeting24.com/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]